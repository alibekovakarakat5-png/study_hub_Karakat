# @SkyllaIELTS_bot. Copy to server/.env.ielts.local, ignored by Git. Do not put real tokens here.
IELTS_TELEGRAM_BOT_TOKEN=
# Optional override; blank derives a separate HMAC credential from this bot's token.
# If overridden, use the exact same value in setup and server environment.
IELTS_TELEGRAM_WEBHOOK_SECRET=
IELTS_TELEGRAM_WEBHOOK_URL=https://creative-simplicity-production.up.railway.app/api/ielts-bot/webhook
IELTS_TELEGRAM_REQUIRED_CHANNEL=@skyllaAI
# Do not replace TELEGRAM_BOT_TOKEN or use @PostFlowEsep_bot's token.
